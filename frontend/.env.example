# ==============================================================================
# DevATS Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:3000/api

# Theme Palette Settings
# Options: 'cyber-indigo' | 'emerald-jade' | 'electric-cyan' | 'solar-amber' | 'neon-rose'
# Default: 'electric-cyan'
VITE_APP_THEME=electric-cyan

# Whether to display the interactive Palette Picker dropdown in the Navbar (true | false)
# Default: false
VITE_APP_SHOW_THEME_PICKER=false

# Whether to allow visitor localStorage overrides (true | false)
# Set to 'false' in corporate/branded deployments where a fixed theme is required.
# Default: true
VITE_APP_ALLOW_THEME_CUSTOMIZATION=true
